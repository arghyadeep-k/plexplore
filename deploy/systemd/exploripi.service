[Unit]
Description=Exploripi Tracker Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exploripi
Group=exploripi
WorkingDirectory=/opt/exploripi
EnvironmentFile=/etc/exploripi/exploripi.env
ExecStart=/opt/exploripi/exploripi-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/exploripi
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
